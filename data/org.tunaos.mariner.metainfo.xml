<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.tunaos.mariner</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Mariner</name>
  <summary>Browse and manage your files</summary>

  <description>
    <p>
      Mariner is a GNOME Files clone built with node-gtk and TypeScript on
      GTK4 and libadwaita. It drives the same Adwaita widgets as Nautilus, so
      the interface feels native to the GNOME desktop.
    </p>
    <p>Features:</p>
    <ul>
      <li>Grid and list views with adjustable zoom</li>
      <li>Tabbed browsing with per-tab history and a breadcrumb path bar</li>
      <li>A places sidebar with bookmarks and mounted volumes</li>
      <li>Copy, move, rename, trash and delete with live progress</li>
      <li>Recursive, out-of-process search that streams results as they arrive</li>
      <li>Archive extraction and compression, batch rename, and image thumbnails</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.tunaos.mariner.desktop</launchable>

  <categories>
    <category>Utility</category>
    <category>System</category>
    <category>FileManager</category>
  </categories>

  <provides>
    <binary>mariner</binary>
  </provides>

  <url type="homepage">https://github.com/romgrk/mariner</url>
  <url type="bugtracker">https://github.com/romgrk/mariner/issues</url>

  <developer id="com.github.romgrk">
    <name>Rom Grk</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <!-- Stores use these to tint the app's page and its placeholder tile before
       any screenshot loads. Without them Mariner renders as flat grey. -->
  <branding>
    <color type="primary" scheme_preference="light">#c0bfbc</color>
    <color type="primary" scheme_preference="dark">#3d3846</color>
  </branding>

  <!-- Lets a store say "works on your device" instead of "Desktop Only". The
       adaptive Adwaita layout goes down to a phone-width window. -->
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>

  <releases>
    <release version="0.0.1" date="2026-07-01">
      <description>
        <p>Initial packaged release.</p>
      </description>
    </release>
  </releases>
</component>
